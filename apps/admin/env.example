# Copy to apps/admin/.env.local for local overrides. Nothing here is secret.

# --- Showcase ---------------------------------------------------------------
# Sub-path the app is mounted under. Must be the same at build AND start.
NEXT_PUBLIC_BASE_PATH=/markerloop-studio
# The in-process mock backend (src/demo/server). Set to "false" to talk to a
# real Markerloop gateway instead (then set the API variables below).
NEXT_PUBLIC_DEMO_MODE=true

# --- Real backend (only with NEXT_PUBLIC_DEMO_MODE=false) -------------------
# Browser-facing API base; default is the relative <basePath>/api.
# NEXT_PUBLIC_API_URL=https://api.example.com/api
# Server-side gateway address (route handlers, server components).
# API_INTERNAL_URL=http://gateway:8080/api
# Shared key the admin's server sends to auth-service with the client IP.
# SERVICE_KEY=<service-key>
# Public delivery host of files-service.
# FILES_PUBLIC_BASE_URL=https://files.example.com

# --- Runtime section flags (default "true" in this snapshot) ---------------
PAGES_SECTION_ENABLED=true
PAGES_PUBLISH_ENABLED=true

# --- Error reporting (optional; off when empty) -----------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
