{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:i18n": "node scripts/validate-i18n-keys.mjs",
    "test:site-theme": "tsx --test src/entities/site-theme/model.test.ts src/entities/site-theme/errors.test.ts src/widgets/workspace-settings/custom-colors-form.test.tsx",
    "validate:policy": "node scripts/validate-policy.mjs",
    "prebuild": "pnpm validate:i18n && pnpm validate:policy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next node_modules",
    "catalog:manifest": "tsx scripts/catalog-manifest.ts",
    "catalog:manifest:check": "tsx scripts/catalog-manifest.ts --check",
    "catalog:manifest:test": "tsx --test scripts/catalog-manifest.test.ts",
    "catalog:api": "tsx scripts/element-catalog-api.ts",
    "catalog:api:check": "tsx scripts/element-catalog-api.ts --check",
    "catalog:api:test": "tsx --test scripts/element-catalog-api.test.ts",
    "site-theme-presets:test": "tsx --test scripts/site-theme-presets-api.test.ts",
    "demo:check": "tsx src/demo/validate-seed.ts",
    "catalog:check": "tsx scripts/catalog-manifest.ts --check && tsx --test scripts/catalog-manifest.test.ts && tsx scripts/element-catalog-api.ts --check && tsx --test scripts/element-catalog-api.test.ts && tsx --test scripts/site-theme-presets-api.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@markerloop/engine": "workspace:*",
    "@markerloop/policy": "workspace:*",
    "@markerloop/studio": "workspace:*",
    "@markerloop/ui": "workspace:*",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "next": "catalog:",
    "next-intl": "^4.6.1",
    "nextjs-toploader": "^3.9.17",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "sonner": "^2.0.7",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "^8.17.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
