    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
