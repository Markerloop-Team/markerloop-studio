{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace site (SDL-685): server-renders the published page of a workspace by the request Host.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test:ssr": "tsx --test test/ssr.test.ts test/site-api.test.ts",
    "test:unit": "tsx --test test/site-api.test.ts",
