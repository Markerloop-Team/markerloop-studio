        "page / admin, kk, permissions, link + icon context",
        "page / guest, ru, no can()",
        "page / no context",
        "page / editable",
        "server Sauna (react/server) with schema + extra context",
        "client Sauna (react) inside SaunaProvider"
      ]
    }
  },
