            "children": [
              "a",
              "b",
              "c"
            ]
          },
          "a": {
            "type": "Text",
            "props": {
              "children": "open"
            },
            "visibility": "public"
          },
          "b": {
            "type": "Text",
            "props": {
              "children": "legacy"
            },
            "visibility": {
              "when": {
                "op": "truthy",
                "path": "user.id"
              }
            }
          },
          "c": {
            "type": "Text",
            "props": {
              "children": "wide",
              "size": "lg"
            },
            "screens": {
              "mobile": {
                "props": {
                  "size": "sm"
                }
              }
            }
          }
        },
        "parents": {
          "root": null,
          "a": "root",
          "b": "root",
          "c": "root"
        }
      },
      "expect_shell": {
        "version": 2,
        "rootId": "root",
        "nodes": {
          "root": {
            "type": "Page",
            "children": [
              "a",
              "b",
              "c"
            ]
          },
          "a": {
            "type": "Text",
            "props": {
              "children": "open"
            },
            "visibility": "public"
          },
          "b": {
            "type": "Text",
            "props": {
              "children": "legacy"
            },
            "visibility": {
              "when": {
                "op": "truthy",
                "path": "user.id"
              }
            }
          },
          "c": {
            "type": "Text",
            "props": {
              "children": "wide",
              "size": "lg"
            },
            "screens": {
              "mobile": {
                "props": {
                  "size": "sm"
                }
              }
            }
          }
        },
        "parents": {
          "root": null,
          "a": "root",
          "b": "root",
          "c": "root"
        }
