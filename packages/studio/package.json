{
  "name": "@markerloop/studio",
  "version": "0.0.0",
  "private": true,
  "description": "Markerloop pages editor (Studio): shell, store with snapshot history, iframe canvas with selection overlay and inline text editing, structure tree, properties panel, autosave, hotkeys. Moved in from the reference's apps/studio/src/studio (SDL-604).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./catalog/server": {
      "types": "./dist/catalog/server.d.ts",
      "default": "./dist/catalog/server.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepare": "pnpm build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "tsx --tsconfig test/tsconfig.json test/run.tsx && tsx --tsconfig test/tsconfig.json test/inspector-controls.tsx && tsx --tsconfig test/tsconfig.json test/image-panel.tsx",
    "clean": "rm -rf dist",
    "test:planted": "node test/planted.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@markerloop/engine": "workspace:*",
    "@markerloop/ui": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "lucide-react": "^0.562.0",
    "react-hotkeys-hook": "^4.6.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^25.0.1",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
