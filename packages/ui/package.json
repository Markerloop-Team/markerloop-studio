{
  "name": "@markerloop/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Markerloop design system: Radix-based UI kit with admin primitives and a prebuilt Tailwind stylesheet. Moved in as a copy of sunday-sauna 0.2.0-alpha.2 (SDL-602).",
  "type": "module",
  "exports": {
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./ui/admin": {
      "types": "./dist/ui/admin/index.d.ts",
      "import": "./dist/ui/admin/index.js",
      "require": "./dist/ui/admin/index.cjs"
    },
    "./ui/styles.css": "./ui/styles.css",
    "./props-manifest.json": "./props-manifest.json"
  },
  "files": [
    "dist",
    "ui",
    "props-manifest.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "build": "rm -rf dist && SAUNA_TSUP_CONFIG=ui tsup && node scripts/postbuild.mjs",
    "css:build": "tailwindcss -i ./src/ui/internal/styles/globals.css -o ./ui/styles.css --minify",
    "props:manifest": "node scripts/props-manifest.mjs",
    "props:manifest:check": "node scripts/props-manifest-check.mjs",
    "props:manifest:planted": "node scripts/props-manifest-planted.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.69.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "^10.6.0",
    "tailwindcss": "^4",
    "tsup": "^8.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
